use crate::parser::Name;
// syntax / macro 宣言の解析、パターン照合、マクロ展開
use crate::error::{Ctx, Error};
use crate::eval::{self, Value};
use crate::lexer::{Span, Tok, Token, lex};
use crate::parser::{Block, Expr, Parser, R, Stmt};
use crate::typeck;
use std::cell::OnceCell;
use std::cell::RefCell;
use std::collections::{HashMap, HashSet};
use std::ops::Range;
use std::rc::Rc;
use std::sync::atomic::{AtomicUsize, Ordering};

// パターン照合の結果。検査用に全フィールドを保持する
#[allow(dead_code)]
#[derive(Debug, Clone)]
pub enum Node {
    Token(String, Span),
    Ident(String, Span),
    Int(i64),
    Float(f64),
    Str(String),
    Text(String, Span),
    Expr(Expr),
    Block(Block),
    Stmt(Stmt),
    Type(Expr),
    // syntax 規則・マクロ・名前付きグループの束縛。rule は規則名
    Record {
        rule: Option<String>,
        span: Span,
        fields: Vec<(String, Node)>,
    },
    List(Vec<Node>),
    Null,
    // quote で作った、構造を持たないトークン列
    Raw,
    // 束縛した値と、それが占めるトークンの範囲（展開時にこのトークン列を差し込む）
    At(Range<usize>, Box<Node>),
}

impl Node {
    pub fn strip(&self) -> &Node {
        match self {
            Node::At(_, n) => n.strip(),
            n => n,
        }
    }
    pub fn get(&self, k: &str) -> Option<&Node> {
        match self.strip() {
            Node::Record { fields, .. } => fields.iter().find(|(n, _)| n == k).map(|(_, v)| v),
            _ => None,
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq)]
enum Builtin {
    Ident,
    Int,
    Float,
    Str,
    Template,
    Expr,
    Block,
    Stmt,
    Type,
}

fn builtin(name: &str) -> Option<Builtin> {
    use Builtin::*;
    Some(match name {
        "Ident" => Ident,
        "Int" => Int,
        "Float" => Float,
        "String" => Str,
        "Template" => Template,
        "Expr" => Expr,
        "Block" => Block,
        "Stmt" => Stmt,
        "Type" => Type,
        _ => return None,
    })
}

// 選択枝の並び
#[derive(Debug, Clone)]
struct Pattern(Vec<Seq>);

#[derive(Debug, Clone)]
struct Seq(Vec<Term>);

#[derive(Debug, Clone)]
struct Term {
    adjacent: bool,
    name: Option<String>,
    atom: Atom,
    op: Op,
}

#[derive(Debug, Clone)]
enum Op {
    One,
    Opt,
    Many,
    Many1,
    Sep(Box<Atom>),
}

#[derive(Debug, Clone)]
enum Atom {
    Lit(String),
    Builtin(Builtin),
    Rule(String),
    Group(Pattern),
    // 停止集合（このリテラルで始まるトークンの手前で止まる）
    Text(Vec<String>),
}

// FIRST 集合の要素
#[derive(Debug, Clone, PartialEq)]
enum First {
    Lit(String),
    Class(Builtin),
    // Expr か Stmt。マクロの先頭にあると左再帰になる
    Expr,
    Any,
}

type Firsts = (Vec<First>, bool);

struct Rule {
    pat: Pattern,
    fields: Vec<(String, bool)>,
}

struct Macro {
    name: String,
    pat: Pattern,
    fields: Vec<(String, bool)>,
    // -> Stmt なら文の位置、-> Expr なら式の位置で試す
    stmt: bool,
    decl: bool,
    // 本体のトークン列（コンパイル時に実行するコード）。空なら照合結果を Expr::Macro として残す
    body: Option<Vec<Token>>,
    // 本体で x.do() を使うマクロ。本体は呼び出し位置で実行するコードの雛形（template_body で quote に直してある）
    template: bool,
    compiled: OnceCell<Block>,
    first: Firsts,
    // 定義したモジュール。quote の中のそのモジュールの名前は、修飾した名前にする
    module: String,
}

#[derive(Default)]
pub struct Grammar {
    rules: HashMap<String, Rule>,
    macros: Vec<Macro>,
}

// quote { ... } の要素
#[derive(Debug, Clone)]
pub enum Q {
    Tok(Token),
    // 構造体のフィールド名（Name { x: 式 } の x）。値の名前と違い、改名しない
    Field(Token),
    // $a.b.c。rest は a の後ろの ". 名前" のトークン列
    Var {
        dollar: Token,
        path: Vec<String>,
        rest: Vec<Token>,
    },
    // ${ 式 }
    Splice(Token, Expr),
    // $( ... ) 区切り? *
    Rep(Vec<Q>, Option<Token>),
}
// 束縛名ごとの種類（マクロ本体での型 syn<種類> に使う）。規則名・Ident・Expr などで、配列は [種類]、分からなければ ""
pub type Kinds = Vec<(String, String)>;

// 本体に 照合した名前.do() があれば、雛形として quote { { 本体 } } に直す。x.do() は $x、本体の return は macro_return にする
fn template_body(raw: &[Token], fields: &[(String, bool)]) -> Option<Vec<Token>> {
    let is_do = |i: usize| match &raw[i..] {
        [x, dot, name, open, close, ..] => {
            matches!(&x.tok, Tok::Ident(c) if fields.iter().any(|f| &f.0 == c))
                && dot.tok == Tok::Punct(".")
                && name.tok == Tok::Ident("do".into())
                && open.tok == Tok::Punct("(")
                && close.tok == Tok::Punct(")")
        }
        _ => false,
    };
    if !(0..raw.len()).any(is_do) {
        return None;
    }
    let tok = |t: &Token, k: Tok| Token { tok: k, ..t.clone() };
    let (first, last) = (&raw[0], &raw[raw.len() - 1]);
    let mut out = vec![
        tok(first, Tok::Punct("quote")),
        tok(first, Tok::Punct("{")),
        tok(first, Tok::Punct("{")),
    ];
    let mut i = 0;
    while i < raw.len() {
        if is_do(i) {
            out.push(tok(&raw[i], Tok::Punct("$")));
            out.push(Token {
                gap_before: false,
                nl_before: false,
                ..raw[i].clone()
            });
            i += 5;
            continue;
        }
        out.push(match raw[i].tok {
            Tok::Punct("return") => tok(&raw[i], Tok::Punct("macro_return")),
            _ => raw[i].clone(),
        });
        i += 1;
    }
    out.extend([tok(last, Tok::Punct("}")), tok(last, Tok::Punct("}"))]);
    Some(out)
}

// 雛形の本体の return（構文解析で #return の呼び出しにしてある）を、展開した式の値に直す
const RET_ERR: &str =
    "マクロ本体の return は、本体の文か if・ブロックの中に書く（while・for・無名関数・let の右辺の中には書けない）";

fn is_ret(e: &Expr) -> bool {
    matches!(e.peel(), Expr::Call(n, _) if n == "#return")
}

fn has_ret(e: &Expr) -> bool {
    let mut found = false;
    typeck::walk(e, &mut |x| found |= is_ret(x));
    found
}

// 値になる位置の式
fn ret_tail(e: Expr) -> R<Expr> {
    if !has_ret(&e) {
        return Ok(e);
    }
    Ok(match e {
        Expr::At(s, x) => Expr::At(s, Box::new(ret_tail(*x)?)),
        Expr::Call(n, mut a) if n == "#return" => a.pop().unwrap(),
        Expr::If(c, t, f) if !has_ret(&c) => {
            Expr::If(c, ret_block(t)?, f.map(|f| ret_tail(*f).map(Box::new)).transpose()?)
        }
        Expr::Block(b) => Expr::Block(ret_block(b)?),
        _ => return Err(RET_ERR.into()),
    })
}

// 文の位置の式。return しなかった分岐には、後に続く文 rest を移す
// ponytail: rest は分岐ごとに複製する。return が多いと展開が大きくなる。大きければ、抜け出す印の付いたブロックを IR に足す
fn ret_stmt(e: Expr, rest: Block) -> R<Expr> {
    Ok(match e {
        Expr::At(s, x) => Expr::At(s, Box::new(ret_stmt(*x, rest)?)),
        Expr::Call(n, mut a) if n == "#return" => a.pop().unwrap(),
        Expr::If(c, t, f) if !has_ret(&c) => {
            let t = ret_block(join(t, rest.clone()))?;
            let f = match f {
                Some(f) => join(Block { id: Default::default(), stmts: vec![Stmt::Expr(*f)], tail: None }, rest),
                None => rest,
            };
            Expr::If(c, t, Some(Box::new(Expr::Block(ret_block(f)?))))
        }
        // ponytail: ブロックの let が rest からも見える。名前が重なれば外側の変数を隠す
        Expr::Block(b) => Expr::Block(ret_block(join(b, rest))?),
        _ => return Err(RET_ERR.into()),
    })
}

// return を含む最初の文で、残りの文をその文の分岐に移す
fn ret_block(b: Block) -> R<Block> {
    let mut stmts = Vec::new();
    let mut it = b.stmts.into_iter();
    while let Some(s) = it.next() {
        match s {
            Stmt::Expr(e) if has_ret(&e) => {
                let rest = Block { id: Default::default(),
                    stmts: it.collect(),
                    tail: b.tail,
                };
                return Ok(Block { id: Default::default(),
                    stmts,
                    tail: Some(Box::new(ret_stmt(e, rest)?)),
                });
            }
            Stmt::Let { init, .. } if has_ret(&init) => return Err(RET_ERR.into()),
            s => stmts.push(s),
        }
    }
    let tail = b.tail.map(|t| ret_tail(*t).map(Box::new)).transpose()?;
    Ok(Block { id: Default::default(), stmts, tail })
}

// a の後に b を続けたブロック。a の最後の式の値は捨てる
fn join(a: Block, b: Block) -> Block {
    let mut stmts = a.stmts;
    stmts.extend(a.tail.map(|t| Stmt::Expr(*t)));
    stmts.extend(b.stmts);
    Block { id: Default::default(),
        stmts,
        tail: b.tail,
    }
}

fn field_kinds(p: &Pattern) -> Kinds {
    let mut out: Kinds = Vec::new();
    for t in p.0.iter().flat_map(|s| &s.0) {
        let rep = !matches!(t.op, Op::One | Op::Opt);
        let wrap = |k: String| {
            if rep && !k.is_empty() {
                format!("[{k}]")
            } else if rep {
                String::new()
            } else {
                k
            }
        };
        let fs = match (&t.name, &t.atom) {
            (Some(n), a) => vec![(n.clone(), wrap(atom_kind(a)))],
            (None, Atom::Group(inner)) => field_kinds(inner)
                .into_iter()
                .map(|(n, k)| (n, wrap(k)))
                .collect(),
            _ => vec![],
        };
        for (n, k) in fs {
            match out.iter_mut().find(|f| f.0 == n) {
                // 選択枝ごとに種類が違えば分からないものとする
                Some(f) if f.1 != k => f.1 = String::new(),
                Some(_) => {}
                None => out.push((n, k)),
            }
        }
    }
    out
}

fn atom_kind(a: &Atom) -> String {
    match a {
        Atom::Lit(_) => "Token".into(),
        Atom::Builtin(b) => format!("{b:?}"),
        Atom::Rule(r) => r.clone(),
        Atom::Text(_) => "Text".into(),
        // 束縛の無い1項だけのグループ (P % ",") はその項の値になる。それ以外は種類を付けない
        Atom::Group(p) => match p.0.as_slice() {
            [s] if s.0.len() == 1 && s.0[0].name.is_none() && field_kinds(p).is_empty() => {
                let t = &s.0[0];
                let k = atom_kind(&t.atom);
                if matches!(t.op, Op::One | Op::Opt) || k.is_empty() {
                    k
                } else {
                    format!("[{k}]")
                }
            }
            _ => String::new(),
        },
    }
}

// パターンが持つ束縛名と、それが繰り返し（配列）かを求める。同じ連接内の重複はエラー
fn fields(p: &Pattern) -> R<Vec<(String, bool)>> {
    let mut all: Vec<(String, bool)> = Vec::new();
    for seq in &p.0 {
        let mut seen: Vec<(String, bool)> = Vec::new();
        for t in &seq.0 {
            let fs = match (&t.name, &t.atom) {
                (Some(n), _) => vec![(n.clone(), false)],
                // 無名グループの束縛は親に持ち上げる
                (None, Atom::Group(inner)) => {
                    let rep = !matches!(t.op, Op::One | Op::Opt);
                    fields(inner)?
                        .into_iter()
                        .map(|(n, r)| (n, r || rep))
                        .collect()
                }
                _ => vec![],
            };
            for f in fs {
                if seen.iter().any(|s| s.0 == f.0) {
                    return Err(format!("束縛名 {} が重複している", f.0).into());
                }
                seen.push(f);
            }
        }
        // 選択枝をまたぐ同名は1個のフィールドにまとめる
        for f in seen {
            if !all.iter().any(|a| a.0 == f.0) {
                all.push(f);
            }
        }
    }
    Ok(all)
}

// 全フィールドを Null か空配列で埋めてから束縛を書き込む
fn record(rule: Option<&str>, span: Span, fields: &[(String, bool)], binds: Binds) -> Node {
    let mut fs: Vec<(String, Node)> = fields
        .iter()
        .map(|(n, rep)| {
            (
                n.clone(),
                if *rep { Node::List(vec![]) } else { Node::Null },
            )
        })
        .collect();
    for (n, v) in binds {
        if let Some(f) = fs.iter_mut().find(|f| f.0 == n) {
            f.1 = v;
        }
    }
    Node::Record {
        rule: rule.map(String::from),
        span,
        fields: fs,
    }
}

// 展開中のマクロの (番号, 大域の名前, マクロのモジュール, そのモジュールから見える名前と修飾した名前)。quote の中の名前の付け替えに使う
type Hygiene = (usize, Rc<HashSet<Name>>, String, HashMap<Name, Name>);
thread_local! {
    static HYGIENE: RefCell<Option<Hygiene>> = const { RefCell::new(None) };
}
static NEXT_EXPANSION: AtomicUsize = AtomicUsize::new(1);

// quote の中で束縛される名前。let と for の変数、fn の引数、match と with の腕の束縛。
// 大域の名前と同じでも、束縛された名前は改名する（呼び出し側の同じ名前を隠さないため）
// ponytail: 同じ quote で、束縛した名前と同じ名前の大域の関数や構築子を呼ぶと、その呼び出しも改名される。呼び出しの位置で大域かどうかを見分けるなら、束縛の範囲を追う必要がある
fn bound_names(q: &[Q]) -> HashSet<Name> {
    // $ の差し込みは None にして、並びを切る
    fn flat(q: &[Q], out: &mut Vec<Option<Tok>>) {
        for x in q {
            match x {
                Q::Tok(t) | Q::Field(t) => out.push(Some(t.tok.clone())),
                Q::Rep(inner, _) => flat(inner, out),
                Q::Var { .. } | Q::Splice(..) => out.push(None),
            }
        }
    }
    let mut ts = Vec::new();
    flat(q, &mut ts);
    let is = |i: usize, t: &Tok| ts.get(i).is_some_and(|x| x.as_ref() == Some(t));
    let ident = |i: usize| match ts.get(i) {
        Some(Some(Tok::Ident(n))) => Some(n.clone()),
        _ => None,
    };
    let p = |s: &'static str| Tok::Punct(s);
    let mut out = HashSet::new();
    for i in 0..ts.len() {
        // let x・let mut x・for x in
        if is(i, &p("let")) || is(i, &p("for")) {
            let j = if is(i + 1, &p("mut")) { i + 2 } else { i + 1 };
            out.extend(ident(j));
        }
        // fn 名(引数) と fn(引数)、構築子(束縛) -> の束縛。( の位置で、閉じ ) までを見る
        let fn_params =
            is(i, &p("(")) && (is(i.wrapping_sub(1), &p("fn")) || is(i.wrapping_sub(2), &p("fn")));
        let arm = is(i, &p("(")) && ident(i.wrapping_sub(1)).is_some() && {
            let mut d = 0;
            let mut k = i;
            while k < ts.len() && !(d == 1 && is(k, &p(")"))) {
                d += is(k, &p("(")) as i32 - is(k, &p(")")) as i32;
                k += 1;
            }
            is(k + 1, &p("->"))
        };
        if fn_params || arm {
            // 中の名前で、直前が ( か , で、入れ子の括弧の外にあるもの
            let mut d = 0;
            for k in i + 1.. {
                if is(k, &p(")")) && d == 0 {
                    break;
                }
                if k >= ts.len() {
                    break;
                }
                d += is(k, &p("(")) as i32 - is(k, &p(")")) as i32;
                if d == 0 && (is(k - 1, &p("(")) || is(k - 1, &p(","))) {
                    out.extend(ident(k));
                }
            }
        }
    }
    out
}

// quote に直接書いた名前を、展開ごとに固有の名前 名前#番号 にする（利用者は # を書けないので衝突しない）。
// 大域の名前と、. の後のフィールド名はそのまま。ただし束縛された名前（bound_names）は大域の名前でも改名する。
// $x で差し込んだ呼び出し側のトークンはここを通らない
fn hygienic(t: &Token, prev: Option<&Token>, bound: &HashSet<Name>) -> Token {
    HYGIENE.with(|h| match (&*h.borrow(), &t.tok) {
        _ if matches!(prev.map(|p| &p.tok), Some(Tok::Punct(".")))
            || t.tok == Tok::Ident("_".into()) =>
        {
            t.clone()
        }
        // ライブラリのマクロが自分のモジュールの名前を使うなら、使う側でもその名前を指すよう修飾する
        (Some((_, _, m, names)), Tok::Ident(n))
            if !m.is_empty() && names.contains_key(n) && !bound.contains(n) =>
        {
            Token {
                tok: Tok::Ident(names[n].clone().into()),
                ..t.clone()
            }
        }
        (Some((id, globals, _, _)), Tok::Ident(n)) if !globals.contains(n) || bound.contains(n) => {
            Token {
                tok: Tok::Ident(Name::hygienic(n, *id)),
                ..t.clone()
            }
        }
        _ => t.clone(),
    })
}

// パターンのリテラルを集める
fn collect_lits(p: &Pattern, out: &mut Vec<String>) {
    for t in p.0.iter().flat_map(|s| &s.0) {
        let sep = match &t.op {
            Op::Sep(a) => Some(&**a),
            _ => None,
        };
        for a in std::iter::once(&t.atom).chain(sep) {
            match a {
                Atom::Lit(s) => out.push(s.clone()),
                Atom::Group(inner) => collect_lits(inner, out),
                _ => {}
            }
        }
    }
}

fn collect_refs(p: &Pattern, out: &mut Vec<String>) {
    for t in p.0.iter().flat_map(|s| &s.0) {
        let sep = match &t.op {
            Op::Sep(a) => Some(&**a),
            _ => None,
        };
        for a in std::iter::once(&t.atom).chain(sep) {
            match a {
                Atom::Rule(n) => out.push(n.clone()),
                Atom::Group(inner) => collect_refs(inner, out),
                _ => {}
            }
        }
    }
}

fn lits(f: &[First]) -> Vec<String> {
    f.iter()
        .filter_map(|x| match x {
            First::Lit(s) => Some(s.clone()),
            _ => None,
        })
        .collect()
}

// syn 型の値。node の At の範囲は toks を指す
#[derive(Debug)]
pub struct Syn {
    pub node: Node,
    pub toks: Rc<Vec<Token>>,
}

impl Syn {
    pub fn child(&self, node: Node) -> Syn {
        Syn {
            node,
            toks: self.toks.clone(),
        }
    }
}

// 型検査で syn の == を禁止しているので呼ばれない
impl PartialEq for Syn {
    fn eq(&self, _: &Self) -> bool {
        false
    }
}

// path を env の最長一致から辿り、(値, 辿った段数) を返す。stop_at_list なら配列で止まる
fn walk(env: &[(Name, Value)], path: &[String], stop_at_list: bool) -> R<(Value, usize)> {
    let mut best: Option<(&Value, usize)> = None;
    for (k, v) in env {
        let ks: Vec<&str> = k.split('.').collect();
        let hit = ks.len() <= path.len() && ks.iter().zip(path).all(|(a, b)| a == b);
        // 同じ長さなら後に積んだ（内側の）束縛を優先する
        if hit && best.is_none_or(|b| ks.len() >= b.1) {
            best = Some((v, ks.len()));
        }
    }
    let (v, mut n) = best.ok_or(format!("未定義の変数 {}", path[0]))?;
    let mut v = v.clone();
    while n < path.len() {
        let Value::Syn(s) = &v else { break };
        if stop_at_list && matches!(s.node.strip(), Node::List(_)) {
            break;
        }
        let Some(c) = s.node.get(&path[n]) else { break };
        v = Value::Syn(Rc::new(s.child(c.clone())));
        n += 1;
    }
    Ok((v, n))
}

fn q_paths<'a>(q: &'a [Q], out: &mut Vec<&'a [String]>) {
    for x in q {
        match x {
            Q::Var { path, .. } => out.push(path),
            Q::Rep(inner, _) => q_paths(inner, out),
            Q::Tok(_) | Q::Field(_) | Q::Splice(..) => {}
        }
    }
}

type Eval<'a> = dyn FnMut(&Expr, &[(Name, Value)]) -> R<Value> + 'a;

// quote の中身を、env の値を差し込みながらトークン列にする。${ } は ev で評価する
pub fn splice(
    q: &[Q],
    env: &mut Vec<(Name, Value)>,
    out: &mut Vec<Token>,
    ev: &mut Eval,
) -> R<()> {
    let bound = bound_names(q);
    splice_in(q, env, out, ev, &bound)
}

fn splice_in(
    q: &[Q],
    env: &mut Vec<(Name, Value)>,
    out: &mut Vec<Token>,
    ev: &mut Eval,
    bound: &HashSet<Name>,
) -> R<()> {
    for x in q {
        match x {
            Q::Tok(t) => out.push(hygienic(t, out.last(), bound)),
            Q::Field(t) => out.push(t.clone()),
            Q::Var { dollar, path, rest } => {
                let (v, n) = walk(env, path, false)?;
                emit(&v, dollar, out).map_err(|e| {
                    Error::from(format!("${}: {e}", path.join("."))).at(dollar.span)
                })?;
                // 束縛の中に無い残りの経路は、式のフィールド参照として残す
                out.extend(rest[2 * (n - 1)..].iter().cloned());
            }
            Q::Splice(dollar, e) => {
                let v = ev(e, env)?;
                emit(&v, dollar, out)
                    .map_err(|e| Error::from(format!("${{ }}: {e}")).at(dollar.span))?;
            }
            Q::Rep(inner, sep) => {
                let mut paths = Vec::new();
                q_paths(inner, &mut paths);
                let mut lists: Vec<(String, Rc<Syn>)> = Vec::new();
                for p in paths {
                    let (v, n) = walk(env, p, true)?;
                    let key = p[..n].join(".");
                    if let Value::Syn(s) = v
                        && matches!(s.node.strip(), Node::List(_))
                        && !lists.iter().any(|l| l.0 == key)
                    {
                        lists.push((key, s));
                    }
                }
                let len = |s: &Syn| match s.node.strip() {
                    Node::List(v) => v.len(),
                    _ => 0,
                };
                let Some(n) = lists.first().map(|l| len(&l.1)) else {
                    return Err("$( )* の中に配列の束縛が無い".into());
                };
                if lists.iter().any(|l| len(&l.1) != n) {
                    return Err("$( )* の中の配列の長さが揃っていない".into());
                }
                for k in 0..n {
                    if k > 0
                        && let Some(s) = sep
                    {
                        out.push(s.clone());
                    }
                    let base = env.len();
                    for (key, s) in &lists {
                        let Node::List(v) = s.node.strip() else {
                            unreachable!()
                        };
                        env.push((Name::from(key.as_str()), Value::Syn(Rc::new(s.child(v[k].clone())))));
                    }
                    let r = splice_in(inner, env, out, ev, bound);
                    env.truncate(base);
                    r?;
                }
            }
        }
    }
    Ok(())
}

// 値をトークン列にして差し込む。先頭の空白・改行の有無は $ の位置に合わせる
fn emit(v: &Value, dollar: &Token, out: &mut Vec<Token>) -> R<()> {
    let at_dollar = |t: &Token| Token {
        gap_before: dollar.gap_before,
        nl_before: dollar.nl_before,
        ..t.clone()
    };
    let tok = |tok: Tok| Token {
        tok,
        gap_before: false,
        nl_before: false,
        ..dollar.clone()
    };
    let s = match v {
        Value::Int(n) if *n < 0 => {
            out.push(at_dollar(&tok(Tok::Punct("("))));
            out.extend([
                tok(Tok::Punct("-")),
                tok(Tok::Int(n.unsigned_abs() as i64)),
                tok(Tok::Punct(")")),
            ]);
            return Ok(());
        }
        Value::Int(n) => Tok::Int(*n),
        Value::Num(n) => Tok::Float(*n),
        Value::Bool(b) => Tok::Punct(if *b { "true" } else { "false" }),
        Value::Str(s) => Tok::Str(s.to_string()),
        Value::Ty(t) => Tok::Ident(t.to_string().into()),
        Value::Arr(_) | Value::Data(_) | Value::Fn(_) => {
            return Err("配列・data・関数の値は差し込めない".into());
        }
        Value::Unit => return Err("() は差し込めない".into()),
        Value::Ref(_) => return Err("参照は差し込めない".into()),
        Value::Syn(s) => return emit_syn(s, dollar, out),
    };
    out.push(at_dollar(&tok(s)));
    Ok(())
}

fn emit_syn(s: &Syn, dollar: &Token, out: &mut Vec<Token>) -> R<()> {
    let at_dollar = |t: &Token| Token {
        gap_before: dollar.gap_before,
        nl_before: dollar.nl_before,
        ..t.clone()
    };
    let Node::At(range, inner) = &s.node else {
        return match s.node {
            Node::Null => Ok(()),
            _ => Err("配列は $( )* の中で使う".into()),
        };
    };
    let toks = &s.toks[range.clone()];
    match inner.strip() {
        Node::Null => Ok(()),
        Node::List(_) => Err("配列は $( )* の中で使う".into()),
        Node::Text(t, _) => {
            out.push(at_dollar(&Token {
                tok: Tok::Str(t.clone()),
                ..toks[0].clone()
            }));
            Ok(())
        }
        n => {
            let Some(first) = toks.first() else {
                return Ok(());
            };
            // 式は括弧で囲み、差し込み先の演算子と結合しないようにする
            // ponytail: quote で作った断片（Raw）は囲まない。必要なら quote の中で括弧を書く
            if matches!(n, Node::Expr(_)) {
                out.push(at_dollar(&Token {
                    tok: Tok::Punct("("),
                    ..first.clone()
                }));
                out.push(Token {
                    gap_before: false,
                    nl_before: false,
                    ..first.clone()
                });
                out.extend(toks[1..].iter().cloned());
                out.push(Token {
                    tok: Tok::Punct(")"),
                    gap_before: false,
                    nl_before: false,
                    ..first.clone()
                });
            } else {
                out.push(at_dollar(first));
                out.extend(toks[1..].iter().cloned());
            }
            Ok(())
        }
    }
}

impl Grammar {
    pub fn literals(&self) -> Vec<String> {
        let mut out = Vec::new();
        for p in self
            .rules
            .values()
            .map(|r| &r.pat)
            .chain(self.macros.iter().map(|m| &m.pat))
        {
            collect_lits(p, &mut out);
        }
        out
    }

    pub fn validate(&mut self) -> R<()> {
        let mut refs = Vec::new();
        for r in self.rules.values() {
            collect_refs(&r.pat, &mut refs);
        }
        for m in &self.macros {
            collect_refs(&m.pat, &mut refs);
        }
        if let Some(n) = refs.iter().find(|n| !self.rules.contains_key(*n)) {
            return Err(format!("未定義の規則 {n}").into());
        }
        for (n, r) in &self.rules {
            self.first_pat(&r.pat, &mut vec![n.clone()])?;
        }
        let names: Vec<String> = self.rules.keys().cloned().collect();
        for n in names {
            let mut p = self.rules[&n].pat.clone();
            self.resolve_text(&mut p, &[])?;
            self.rules.get_mut(&n).unwrap().pat = p;
        }
        for i in 0..self.macros.len() {
            let mut p = self.macros[i].pat.clone();
            self.resolve_text(&mut p, &[])?;
            let first = self.first_pat(&p, &mut vec![])?;
            if first.0.contains(&First::Expr) {
                return Err(format!(
                    "マクロ {} が Expr か Stmt で始まる（左再帰になる）",
                    self.macros[i].name
                )
                .into());
            }
            let m = &mut self.macros[i];
            m.pat = p;
            m.first = first;
        }
        Ok(())
    }

    // st は辿っている規則の列。同じ規則に先頭で戻ったら左再帰
    fn first_pat(&self, p: &Pattern, st: &mut Vec<String>) -> R<Firsts> {
        let (mut acc, mut nullable) = (Vec::new(), false);
        for s in &p.0 {
            let (f, n) = self.first_seq(&s.0, st)?;
            acc.extend(f);
            nullable |= n;
        }
        Ok((acc, nullable))
    }

    fn first_seq(&self, terms: &[Term], st: &mut Vec<String>) -> R<Firsts> {
        let mut acc = Vec::new();
        for t in terms {
            let (f, n) = self.first_term(t, st)?;
            acc.extend(f);
            if !n {
                return Ok((acc, false));
            }
        }
        Ok((acc, true))
    }

    fn first_term(&self, t: &Term, st: &mut Vec<String>) -> R<Firsts> {
        let (f, n) = match &t.atom {
            Atom::Lit(s) => (vec![First::Lit(s.clone())], false),
            Atom::Text(_) => (vec![First::Any], false),
            Atom::Builtin(b) => (
                vec![match b {
                    Builtin::Expr | Builtin::Stmt => First::Expr,
                    Builtin::Block => First::Lit("{".into()),
                    Builtin::Type => First::Class(Builtin::Ident),
                    b => First::Class(*b),
                }],
                false,
            ),
            Atom::Group(p) => self.first_pat(p, st)?,
            Atom::Rule(n) => {
                if st.contains(n) {
                    return Err(format!("規則 {n} が左再帰している").into());
                }
                st.push(n.clone());
                let r = self.first_pat(&self.rules[n].pat, st);
                st.pop();
                r?
            }
        };
        Ok((f, n || matches!(t.op, Op::Opt | Op::Many | Op::Sep(_))))
    }

    // Text の停止集合を、同じ選択の他の枝の先頭と、連接で次に来る項の先頭から決める
    fn resolve_text(&self, p: &mut Pattern, outer: &[String]) -> R<()> {
        let firsts: Vec<Vec<String>> =
            p.0.iter()
                .map(|s| Ok(lits(&self.first_seq(&s.0, &mut vec![])?.0)))
                .collect::<R<_>>()?;
        for i in 0..p.0.len() {
            let mut stop = outer.to_vec();
            for (j, f) in firsts.iter().enumerate() {
                if j != i {
                    stop.extend(f.iter().cloned());
                }
            }
            for k in 0..p.0[i].0.len() {
                let mut s = stop.clone();
                if let Some(next) = p.0[i].0.get(k + 1) {
                    s.extend(lits(&self.first_term(next, &mut vec![])?.0));
                }
                let t = &mut p.0[i].0[k];
                let sep = match &mut t.op {
                    Op::Sep(a) => Some(&mut **a),
                    _ => None,
                };
                for a in std::iter::once(&mut t.atom).chain(sep) {
                    match a {
                        Atom::Text(st) => *st = s.clone(),
                        Atom::Group(inner) => self.resolve_text(inner, &s)?,
                        _ => {}
                    }
                }
            }
        }
        Ok(())
    }
}

// 照合失敗。Fail は巻き戻して次を試す。Fatal は解析全体を止める
enum Miss {
    Fail,
    Fatal(String),
}

type M<T> = Result<T, Miss>;
type Binds = Vec<(String, Node)>;

impl Parser<'_> {
    pub fn syntax_decl(&mut self, g: &mut Grammar) -> R<()> {
        self.expect("syntax")?;
        let name = self.ident()?.to_string();
        if builtin(&name).is_some() || name == "Text" || g.rules.contains_key(&name) {
            return self.err_at(format!("規則 {name} が重複している"));
        }
        self.expect("=")?;
        let pat = self.pattern()?;
        // 宣言の終わりは次の宣言の始まりで分かるので、";" は省ける
        self.eat(";");
        let fields = fields(&pat).ctx(|e| format!("規則 {name}: {e}"))?;
        g.rules.insert(name, Rule { pat, fields });
        Ok(())
    }

    pub fn macro_decl(&mut self, g: &mut Grammar) -> R<()> {
        self.expect("macro")?;
        let name = self.ident()?.to_string();
        if g.macros.iter().any(|m| m.name == name) {
            return self.err_at(format!("マクロ {name} が重複している"));
        }
        self.expect("(")?;
        let pat = self.pattern()?;
        self.expect(")")?;
        let mut decl = false;
        let stmt = if self.eat("->") {
            match self.ident()?.as_str() {
                "Expr" => false,
                "Stmt" => true,
                "Decl" => { decl = true; false },
                _ => return self.err_at("マクロの戻り値は Expr・Stmt・Decl".into()),
            }
        } else {
            false
        };
        self.expect("{")?;
        let start = self.pos;
        let mut depth = 1;
        while depth > 0 {
            match self.next() {
                Tok::Punct("{") => depth += 1,
                Tok::Punct("}") => depth -= 1,
                Tok::Eof => return self.err("マクロ本体の \"}\" が足りない"),
                _ => {}
            }
        }
        let fields = fields(&pat).ctx(|e| format!("マクロ {name}: {e}"))?;
        let raw = &self.toks[start..self.pos - 1];
        let template = template_body(raw, &fields);
        let body = if raw.is_empty() {
            None
        } else {
            Some(template.clone().unwrap_or_else(|| raw.to_vec()))
        };
        g.macros.push(Macro {
            name,
            pat,
            fields,
            stmt,
            decl,
            body,
            template: template.is_some(),
            first: (vec![], true),
            compiled: OnceCell::new(),
            module: self.cur_module(),
        });
        Ok(())
    }

    fn pattern(&mut self) -> R<Pattern> {
        self.eat("|");
        let mut branches = vec![self.seq()?];
        while self.eat("|") {
            branches.push(self.seq()?);
        }
        Ok(Pattern(branches))
    }

    fn seq(&mut self) -> R<Seq> {
        let mut terms = Vec::new();
        while matches!(
            self.peek(),
            Tok::Punct("~" | "(") | Tok::Ident(_) | Tok::Str(_)
        ) {
            terms.push(self.term()?);
        }
        if terms.is_empty() {
            return self.err("パターンの項が必要");
        }
        Ok(Seq(terms))
    }

    fn term(&mut self) -> R<Term> {
        let adjacent = self.eat("~");
        let mut name = None;
        if let Tok::Ident(n) = self.peek().clone()
            && matches!(
                self.toks.get(self.pos + 1).map(|t| &t.tok),
                Some(Tok::Punct(":"))
            )
        {
            self.pos += 2;
            name = Some(n.to_string());
        }
        let atom = self.atom()?;
        let op = if self.eat("*") {
            Op::Many
        } else if self.eat("+") {
            Op::Many1
        } else if self.eat("?") {
            Op::Opt
        } else if self.eat("%") {
            Op::Sep(Box::new(self.atom()?))
        } else {
            Op::One
        };
        Ok(Term {
            adjacent,
            name,
            atom,
            op,
        })
    }

    fn atom(&mut self) -> R<Atom> {
        let a = match self.peek().clone() {
            Tok::Str(s) => {
                let ts = lex(&s)?;
                // 修飾名のリテラルは、区切りを含む綴りで照合する。
                match (ts.len(), ts[0].tok.text()) {
                    (2, Some(t)) if !t.is_empty() => Atom::Lit(t.to_string()),
                    _ => return self.err_at(format!("リテラル {s:?} は1個のトークンでない")),
                }
            }
            Tok::Ident(n) if n == "Text" => Atom::Text(vec![]),
            Tok::Ident(n) => builtin(&n).map(Atom::Builtin).unwrap_or(Atom::Rule(n.to_string())),
            Tok::Punct("(") => {
                self.pos += 1;
                let p = self.pattern()?;
                self.expect(")")?;
                return Ok(Atom::Group(p));
            }
            _ => return self.err("パターンの項が必要"),
        };
        self.pos += 1;
        Ok(a)
    }

    // 文の位置（stmt）か式の位置で、全マクロを照合する
    pub fn try_macros(&mut self, stmt: bool) -> R<Option<Expr>> {
        let g = self.g.clone();
        let start = self.pos;
        let Some((k, rec)) = self.find_macro(|m| !m.decl && m.stmt == stmt)? else {
            return Ok(None);
        };
        let m = &g.macros[k];
        match &m.body {
            None => Ok(Some(Expr::Macro(m.name.clone(), Box::new(rec)))),
            Some(_) => {
                let site = self.span_of(start);
                self.expand(m, rec, site).map(Some)
            }
        }
    }

    pub fn declaration_macro(&mut self) -> R<Option<(usize, Node)>> { self.find_macro(|m| m.decl) }
    pub fn expand_declaration(&self, k: usize, rec: Node, site: Span) -> R<Vec<Token>> {
        let m = &self.g.macros[k];
        if m.body.is_none() { return Err("宣言マクロに展開コードが無い".into()); }
        self.expand_toks(m, rec, site)
    }

    // pred に合うマクロを照合する。一つだけ合えば、その番号と照合結果を返し、self.pos を直後に進める
    fn find_macro(&mut self, pred: impl Fn(&Macro) -> bool) -> R<Option<(usize, Node)>> {
        let g = self.g.clone();
        let start = self.pos;
        let mut hits = Vec::new();
        for (k, m) in g.macros.iter().enumerate().filter(|(_, m)| pred(m)) {
            self.pos = start;
            if !self.could_start(&m.first) {
                continue;
            }
            let mut b = Vec::new();
            match self.m_pattern(&m.pat, &mut b) {
                Ok(_) => hits.push((k, m, b, self.pos)),
                Err(Miss::Fail) => {}
                Err(Miss::Fatal(e)) => return self.err_at(e),
            }
        }
        self.pos = start;
        match hits.len() {
            0 => Ok(None),
            1 => {
                let (k, m, b, end) = hits.pop().unwrap();
                self.pos = end;
                Ok(Some((
                    k,
                    record(Some(&m.name), self.span_from(start), &m.fields, b),
                )))
            }
            _ => {
                let names: Vec<&str> = hits.iter().map(|h| h.1.name.as_str()).collect();
                self.err_at(format!("Ambiguous macro match（{}）", names.join(", ")))
            }
        }
    }

    // マクロ本体を構文解析・型検査する。結果は使い回す
    fn macro_block(&self, m: &Macro) -> R<Block> {
        if let Some(b) = m.compiled.get() {
            return Ok(b.clone());
        }
        let raw = m.body.as_ref().unwrap();
        let end = raw.last().unwrap().clone();
        let mut toks = raw.clone();
        toks.extend([
            Token {
                tok: Tok::Punct("}"),
                nl_before: true,
                ..end.clone()
            },
            Token {
                tok: Tok::Eof,
                ..end
            },
        ]);
        let mut p = Parser {
            helpers: self.helpers.clone(),
            toks,
            pos: 0,
            src: self.src,
            g: self.g.clone(),
            depth: self.depth + 1,
            types: self.types.clone(),
            generic_fns: self.generic_fns.clone(),
            globals: self.globals.clone(),
            structs: self.structs.clone(),
            no_struct: false,
            module: m.module.clone(),
            mod_names: self.mod_names.clone(),
            uses: self.uses.clone(),
            modules: self.modules.clone(),
            known: self.known.clone(),
            traits: self.traits.clone(),
        };
        let wrap = |e: &str| format!("マクロ {}: {e}", m.name);
        let mut b = p.block().ctx(wrap)?;
        crate::resolve::resolve_macro(
            &mut b,
            &m.module,
            field_kinds(&m.pat).into_iter().map(|(n, _)| Name::from(n)).collect(),
            &self.uses,
            &self.known,
        );
        let rules: HashMap<String, Kinds> = self
            .g
            .rules
            .iter()
            .map(|(n, r)| (n.clone(), field_kinds(&r.pat)))
            .collect();
        typeck::check_macro(&mut b, &field_kinds(&m.pat), &rules, &self.helpers).ctx(wrap)?;
        let _ = m.compiled.set(b.clone());
        Ok(b)
    }

    // 全マクロの本体を先に検査し、使われていないマクロの誤りも報告する
    pub fn check_macros(&self) -> R<()> {
        for m in self.g.macros.iter().filter(|m| m.body.is_some()) {
            self.macro_block(m)?;
        }
        Ok(())
    }

    // ponytail: 衛生性は quote に書いた名前だけに効く。束縛は字句で数える（let・for・fn の引数・腕の束縛）ので、ほかの形で束縛した名前は改名されない
    // ponytail: 展開のたびにトークン列全体を複製する。遅ければ Parser.toks を Rc にする
    fn expand(&self, m: &Macro, rec: Node, site: Span) -> R<Expr> {
        let wrap = |e: &str| format!("マクロ {} の展開: {e}", m.name);
        let toks = self.expand_toks(m, rec, site)?;
        let end = self.toks[self.pos].clone();
        let eof = Token {
            tok: Tok::Eof,
            ..end.clone()
        };
        let mut p = Parser {
            helpers: self.helpers.clone(),
            toks,
            pos: 0,
            src: self.src,
            g: self.g.clone(),
            depth: self.depth + 1,
            types: self.types.clone(),
            generic_fns: self.generic_fns.clone(),
            globals: self.globals.clone(),
            structs: self.structs.clone(),
            no_struct: false,
            module: self.cur_module(),
            mod_names: self.mod_names.clone(),
            uses: self.uses.clone(),
            modules: self.modules.clone(),
            known: self.known.clone(),
            traits: self.traits.clone(),
        };
        // 一度だけ読み、式が1つならその式、文の並びならブロックにする。
        p.toks.extend([Token { tok: Tok::Punct("}"), nl_before: true, ..end }, eof]);
        let e = match p.block().ctx(wrap)? {
            Block { stmts, tail: Some(e), .. } if !m.stmt && stmts.is_empty() => *e,
            block => Expr::Block(block),
        };
        if m.template { ret_tail(e).ctx(wrap) } else { Ok(e) }
    }

    // マクロ本体を実行し、展開結果をトークン列にする
    fn expand_toks(&self, m: &Macro, rec: Node, site: Span) -> R<Vec<Token>> {
        if self.depth >= 64 {
            return Err(format!("マクロ {} の展開が深すぎる", m.name).into());
        }
        let block = self.macro_block(m)?;
        let Node::Record { fields, .. } = rec else {
            unreachable!()
        };
        let src_toks = Rc::new(self.toks.clone());
        let vars = fields
            .into_iter()
            .map(|(n, node)| {
                (
                    Name::from(n),
                    Value::Syn(Rc::new(Syn {
                        node,
                        toks: src_toks.clone(),
                    })),
                )
            })
            .collect();
        let wrap = |e: &str| format!("マクロ {} の展開: {e}", m.name);
        // 展開ごとに番号を振り、quote に書いた名前をその番号で付け替える
        let id = NEXT_EXPANSION.fetch_add(1, Ordering::Relaxed);
        // 自分のモジュールの名前と、そのモジュールが use で修飾なしに取り込んだ名前（use std -> * など）
        let mut names: HashMap<Name, Name> = HashMap::new();
        for u in self.uses.get(&m.module).into_iter().flatten() {
            for n in self.mod_names.get(&u.module).into_iter().flatten() {
                if u.names.takes(n) {
                    names.insert(n.clone(), Name::qualified(&u.module, n.clone()));
                }
            }
        }
        for n in self.mod_names.get(&m.module).into_iter().flatten() {
            names.insert(n.clone(), Name::qualified(&m.module, n.clone()));
        }
        let prev =
            HYGIENE.with(|h| h.replace(Some((id, self.globals.clone(), m.module.clone(), names))));
        let v = eval::run_macro(&block, vars, &self.helpers);
        HYGIENE.with(|h| h.replace(prev));
        let v = v.map_err(Error::from).ctx(wrap)?;
        let end = self.toks[self.pos].clone();
        let mut toks = Vec::new();
        emit(&v, &end, &mut toks).ctx(wrap)?;
        // 展開したコードの位置は呼び出し位置にする。定義側の位置は利用者の見る場所と違う
        Ok(toks
            .into_iter()
            .map(|t| Token {
                site: Some(site),
                ..t
            })
            .collect())
    }

    fn could_start(&self, (f, nullable): &Firsts) -> bool {
        let t = &self.toks[self.pos].tok;
        *nullable
            || f.iter().any(|x| match x {
                First::Lit(s) => t.text() == Some(s.as_str()),
                First::Class(b) => matches!(
                    (b, t),
                    (Builtin::Ident, Tok::Ident(_))
                        | (Builtin::Int, Tok::Int(_))
                        | (Builtin::Float, Tok::Float(_))
                        | (Builtin::Str, Tok::Str(_))
                        | (Builtin::Template, Tok::Template(..))
                ),
                First::Expr | First::Any => true,
            })
    }

    pub fn span_from(&self, start: usize) -> Span {
        let s = self.toks[start].span.start;
        let end = if self.pos > start {
            self.toks[self.pos - 1].span.end
        } else {
            s
        };
        Span { source: self.toks[start].span.source, start: s, end }
    }

    // start から今までの位置。マクロの展開で作ったトークンが端にあれば、その呼び出し位置を使う
    // ponytail: 端のどちらかが展開のトークンなら、範囲全体を呼び出し位置にする。途中だけが展開の式は、定義側の位置が混じる。範囲の始めと終わりを別々に写せば正確になる
    pub fn span_of(&self, start: usize) -> Span {
        let end = self.pos.saturating_sub(1).max(start);
        self.toks[start]
            .site
            .or(self.toks[end].site)
            .unwrap_or_else(|| self.span_from(start))
    }

    // 選択枝を順に試し、最初に一致した枝を採る
    fn m_pattern(&mut self, p: &Pattern, b: &mut Binds) -> M<Node> {
        let save = self.pos;
        for seq in &p.0 {
            let mut sb = Vec::new();
            match self.m_seq(seq, &mut sb) {
                Ok(v) => {
                    b.extend(sb);
                    return Ok(v);
                }
                Err(Miss::Fail) => self.pos = save,
                Err(e) => return Err(e),
            }
        }
        Err(Miss::Fail)
    }

    fn m_seq(&mut self, seq: &Seq, b: &mut Binds) -> M<Node> {
        let mut vals = Vec::new();
        for t in &seq.0 {
            if t.adjacent && self.toks[self.pos].gap_before {
                return Err(Miss::Fail);
            }
            let start = self.pos;
            let v = match &t.name {
                Some(n) => {
                    let mut inner = Vec::new();
                    let v = self.m_term(t, &mut inner)?;
                    let v = if inner.is_empty() {
                        v
                    } else {
                        Node::Record {
                            rule: None,
                            span: self.span_from(start),
                            fields: inner,
                        }
                    };
                    let v = Node::At(start..self.pos, Box::new(v));
                    b.push((n.clone(), v.clone()));
                    v
                }
                None => self.m_term(t, b)?,
            };
            vals.push(v);
        }
        Ok(if vals.len() == 1 {
            vals.pop().unwrap()
        } else {
            Node::List(vals)
        })
    }

    // 繰り返しの1回分の束縛を、名前ごとの配列に積む
    fn push_binds(lists: &mut Vec<(String, Vec<Node>)>, ib: Binds) {
        for (n, v) in ib {
            match lists.iter_mut().find(|l| l.0 == n) {
                Some(l) => l.1.push(v),
                None => lists.push((n, vec![v])),
            }
        }
    }

    // 繰り返しの1回分を照合し、要素を範囲付きで積む
    fn m_item(
        &mut self,
        a: &Atom,
        items: &mut Vec<Node>,
        lists: &mut Vec<(String, Vec<Node>)>,
    ) -> M<()> {
        let save = self.pos;
        let mut ib = Vec::new();
        let v = self.m_atom(a, &mut ib)?;
        items.push(Node::At(save..self.pos, Box::new(v)));
        Self::push_binds(lists, ib);
        Ok(())
    }

    fn m_term(&mut self, t: &Term, b: &mut Binds) -> M<Node> {
        let mut items = Vec::new();
        let mut lists = Vec::new();
        match &t.op {
            Op::One => return self.m_atom(&t.atom, b),
            Op::Opt => {
                let save = self.pos;
                let mut ob = Vec::new();
                return match self.m_atom(&t.atom, &mut ob) {
                    Ok(v) => {
                        b.extend(ob);
                        Ok(v)
                    }
                    Err(Miss::Fail) => {
                        self.pos = save;
                        Ok(Node::Null)
                    }
                    Err(e) => Err(e),
                };
            }
            Op::Many | Op::Many1 => loop {
                let save = self.pos;
                match self.m_item(&t.atom, &mut items, &mut lists) {
                    // 空一致は無限ループになるので止める
                    Ok(()) if self.pos == save => {
                        items.pop();
                        break;
                    }
                    Ok(()) => {}
                    Err(Miss::Fail) => {
                        self.pos = save;
                        break;
                    }
                    Err(e) => return Err(e),
                }
            },
            Op::Sep(sep) => {
                let save = self.pos;
                match self.m_item(&t.atom, &mut items, &mut lists) {
                    Ok(()) => loop {
                        let save = self.pos;
                        if let Err(e) = self.m_atom(sep, &mut Vec::new()) {
                            if let Miss::Fatal(_) = e {
                                return Err(e);
                            }
                            self.pos = save;
                            break;
                        }
                        match self.m_item(&t.atom, &mut items, &mut lists) {
                            Ok(()) => {}
                            Err(Miss::Fail) => {
                                return Err(Miss::Fatal("区切りの後に要素が無い".into()));
                            }
                            Err(e) => return Err(e),
                        }
                    },
                    Err(Miss::Fail) => self.pos = save,
                    Err(e) => return Err(e),
                }
            }
        }
        if matches!(t.op, Op::Many1) && items.is_empty() {
            return Err(Miss::Fail);
        }
        b.extend(lists.into_iter().map(|(n, v)| (n, Node::List(v))));
        Ok(Node::List(items))
    }

    fn m_atom(&mut self, a: &Atom, b: &mut Binds) -> M<Node> {
        let start = self.pos;
        match a {
            Atom::Lit(s) => {
                let t = &self.toks[self.pos];
                if t.tok.text() != Some(s.as_str()) {
                    return Err(Miss::Fail);
                }
                let span = t.span;
                self.pos += 1;
                Ok(Node::Token(s.clone(), span))
            }
            Atom::Builtin(k) => self.m_builtin(*k),
            Atom::Rule(name) => {
                let g = self.g.clone();
                let r = &g.rules[name];
                let mut rb = Vec::new();
                self.m_pattern(&r.pat, &mut rb)?;
                Ok(record(Some(name), self.span_from(start), &r.fields, rb))
            }
            Atom::Group(p) => self.m_pattern(p, b),
            Atom::Text(stop) => self.m_text(stop),
        }
    }

    fn m_builtin(&mut self, k: Builtin) -> M<Node> {
        let t = self.toks[self.pos].clone();
        let fail = |_| Miss::Fail;
        let n = match (k, t.tok) {
            (Builtin::Ident, Tok::Ident(s)) => Node::Ident(s.to_string(), t.span),
            (Builtin::Int, Tok::Int(n)) => Node::Int(n),
            (Builtin::Float, Tok::Float(n)) => Node::Float(n),
            (Builtin::Str, Tok::Str(s)) => Node::Str(s),
            (Builtin::Template, Tok::Template(raw, _)) => Node::Str(raw),
            // ponytail: コア構文のエラーは Fail として巻き戻すため、入れ子のマクロの曖昧性エラーも消える
            (Builtin::Expr, _) => return self.expr().map(Node::Expr).map_err(fail),
            (Builtin::Stmt, _) => return self.stmt().map(Node::Stmt).map_err(fail),
            (Builtin::Type, _) => return self.ty().map(Node::Type).map_err(fail),
            (Builtin::Block, _) if self.eat("{") => {
                return self.block().map(Node::Block).map_err(fail);
            }
            _ => return Err(Miss::Fail),
        };
        self.pos += 1;
        Ok(n)
    }

    // ponytail: トークン単位で切り出すので、字句解析できない文字（例: Don't の '）は Text に書けない
    fn m_text(&mut self, stop: &[String]) -> M<Node> {
        let start = self.pos;
        loop {
            let stops = match self.peek() {
                Tok::Eof => true,
                Tok::Punct(p) => stop.iter().any(|s| p.starts_with(s.as_str())),
                Tok::Ident(i) => stop.iter().any(|s| s == i),
                _ => false,
            };
            if stops {
                break;
            }
            self.pos += 1;
        }
        if self.pos == start {
            return Err(Miss::Fail);
        }
        let raw =
            &self.src[self.toks[start].span.start.offset..self.toks[self.pos].span.start.offset];
        // JSX と同じく、改行を含む末尾の空白は捨てる
        let trimmed = raw.trim_end();
        let text = if raw[trimmed.len()..].contains('\n') {
            trimmed
        } else {
            raw
        };
        Ok(Node::Text(text.to_string(), self.span_from(start)))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::parser::parse;

    // main の最初の let に書いたマクロの照合結果を取り出す
    fn macro_node(src: &str) -> Node {
        let fns = parse(src).unwrap().fns;
        let main = fns.iter().find(|f| f.name == "main").unwrap();
        match &main.body.stmts[0] {
            Stmt::Let { init, .. } if matches!(init.peel(), Expr::Macro(..)) => {
                let Expr::Macro(_, n) = init.peel() else {
                    unreachable!()
                };
                (**n).clone()
            }
            s => panic!("{s:?}"),
        }
    }

    fn f<'a>(n: &'a Node, k: &str) -> &'a Node {
        n.get(k)
            .unwrap_or_else(|| panic!("{k} が無い: {n:?}"))
            .strip()
    }

    fn list(n: &Node) -> &[Node] {
        match n.strip() {
            Node::List(v) => v,
            _ => panic!("{n:?}"),
        }
    }

    fn ident(n: &Node) -> &str {
        match n.strip() {
            Node::Ident(s, _) => s,
            _ => panic!("{n:?}"),
        }
    }

    const ROUTES: &str = r#"
syntax Annotation = '@' ~ name:Ident '(' args:ExprList? ')' '->' alias:Ident ;
syntax ExprList = items:(Expr % ',') ;
syntax Route = annotations:Annotation* method:Ident path:String body:Block ;
macro routes ('routes' '{' rs:Route* '}') -> Expr {
    // 展開コード
}
fn main() {
    let r = routes {
        GET '/user/{id}' {
            return Response.json({ id });
        }

        @durable_objects('ACCOUNT') -> account
        POST '/post/{user}/{post}' {
            let stub = account.get(user);
            return stub.fetch(request);
        }
    }
}
"#;

    #[test]
    fn routes() {
        let n = macro_node(ROUTES);
        let rs = list(f(&n, "rs"));
        assert_eq!(rs.len(), 2);
        assert_eq!(ident(f(&rs[0], "method")), "GET");
        assert!(list(f(&rs[0], "annotations")).is_empty());
        let a = &list(f(&rs[1], "annotations"))[0];
        assert_eq!(ident(f(a, "name")), "durable_objects");
        assert_eq!(ident(f(a, "alias")), "account");
        assert_eq!(list(f(f(a, "args"), "items")).len(), 1);
        assert!(matches!(f(&rs[1], "path"), Node::Str(s) if s == "/post/{user}/{post}"));

        assert!(parse(&ROUTES.replace("@durable", "@ durable")).is_err());
    }

    #[test]
    fn jsx() {
        let n = macro_node(
            r#"
syntax JsxAttr = name:Ident '=' '{' value:Expr '}'
syntax JsxElement =
    '<' ~ tag:Ident attrs:JsxAttr* '>'
    children:JsxChild*
    '</' ~ close:Ident ~ '>' ;
syntax JsxChild =
    | el:JsxElement
    | '{' expr:Expr '}'
    | text:Text
macro jsx (el:JsxElement) -> Expr {}
fn main() {
    let v = <Button onClick={handleClick}>
        Hello {userName}!
        <Icon name={'star'}></Icon>
    </Button>
}
"#,
        );
        let el = f(&n, "el");
        assert_eq!(ident(f(el, "tag")), "Button");
        assert_eq!(list(f(el, "attrs")).len(), 1);
        let cs = list(f(el, "children"));
        assert_eq!(cs.len(), 4);
        assert!(matches!(f(&cs[0], "text"), Node::Text(s, _) if s == "Hello "));
        assert!(
            matches!(f(&cs[1], "expr"), Node::Expr(e) if matches!(e.peel(), Expr::Var(s) if s == "userName"))
        );
        assert!(matches!(f(&cs[2], "text"), Node::Text(s, _) if s == "!"));
        assert_eq!(ident(f(f(&cs[3], "el"), "tag")), "Icon");
        assert!(matches!(f(&cs[3], "text"), Node::Null));
    }

    #[test]
    fn definition_errors() {
        for (src, msg) in [
            ("syntax L = items:Expr (',' items:Expr)* ;", "重複"),
            ("syntax E = E '+' Int ;", "左再帰"),
            ("syntax A = 'a b' ;", "1個のトークンでない"),
            ("syntax A = B ;", "未定義の規則"),
            ("macro m (e:Expr '!') {}", "左再帰"),
            ("macro m ('m') { quote { $x } }", "未定義の変数 x"),
            ("macro m ('m') { 1 }", "マクロ本体の値"),
            (
                "syntax P = k:Ident '=' v:Expr\nmacro m ('m' p:P) -> Stmt { quote { put($p.vv) } }",
                "フィールド vv は無い",
            ),
            (
                "syntax P = k:Ident '=' v:Expr\nmacro m ('m' p:P) { p.v.w }",
                "syn<Expr> にフィールドは無い",
            ),
            ("macro m ('m' x:Expr) { at(x, 0) }", "at は配列に使う"),
            ("macro m ('m' xs:Expr*) { xs.f }", "要素は at で取り出す"),
            (
                "macro m ('m') { error('だめ') } fn main() { let x = m }",
                "だめ",
            ),
            (
                "macro m ('m' x:Int) { quote { $( $x ) } }",
                "\"*\" が必要",
            ),
            (
                "macro a ('hey') {} macro b ('hey') {} fn main() { let x = hey }",
                "Ambiguous",
            ),
            (
                "syntax L = (Expr % ',') ; macro m ('m' L) {} fn main() { let x = m 1, }",
                "区切り",
            ),
            (
                "macro m ('m' x:Int*) { quote { $x } } fn main() { let y = m 1 2 }",
                "$( )* の中",
            ),
        ] {
            let e = parse(src).unwrap_err();
            assert!(e.contains(msg), "{src} => {e}");
        }
    }
}
