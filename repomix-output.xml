/// 構文木の節点の識別子。移動と複製では保持し、新しい節点には別の値を割り当てる。
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct NodeId(u64);

impl NodeId {
    // 実行時の名前を作るための番号
    pub fn raw(self) -> u64 {
