enum List<A> { Nil, Cons(x: A, xs: List<A>) }

// 関数を受け取る関数。f の型は (A) -> B。A と B はジェネリック引数で、呼ぶ側では省ける
fn map<A, B>(f: (A) -> B, l: List<A>) -> List<B> {
    match l {
        Nil -> Nil
        Cons(x, xs) -> Cons(f(x), map(f, xs))
    }
}

fn sum(l: List<int>) -> int {
    match l {
        Nil -> 0
        Cons(x, xs) -> x + sum(xs)
    }
}

// 関数を返す関数。無名関数は作った時の n を覚えている
fn adder(n: int) -> (int) -> int { fn(x) { x + n } }
fn twice(f: (int) -> int) -> (int) -> int { fn(x) { f(f(x)) } }
fn add(a: int, b: int) -> int { a + b }

fn main() {
    let inc = fn(x: int) -> int { x + 1 }
    put(twice(inc)(3))
    put(adder(10)(5))
    let l = Cons(1, Cons(2, Cons(3, Nil)))
    put(sum(map(adder(100), l)))
    put(sum(map<int, int>(inc, l)))
    let f: (int, int) -> int = add
    put(f(2, 3))
}
