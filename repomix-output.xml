// .do() を使うマクロ（雛形）。本体は呼び出し位置で実行し、return はマクロの値になる
macro unless('unless' expr:Expr block:Block) {
    if ! expr.do() {
        return block.do()
    }
}

// 値を返す雛形。return しなかった時は続きの文が値になる
macro pick('pick' c:Expr a:Expr b:Expr) {
    let x = 1
    if c.do() {
        return a.do() + x
    }
    b.do() + x
}

fn early() -> int {
    unless true { return 1 }
    unless false { return 2 }
    3
}

