use crate::parser::Name;
use crate::check::typeck::{MIN_SAFE_INT, MAX_SAFE_INT};
use crate::error::Error;
use crate::lexer::{Span, Tok, Token};
use crate::meta::{self, Node, Syn};
use crate::parser::{Block, Expr, Fn, Program, Stmt};
use std::collections::HashMap;
use std::io::Write;
use std::rc::Rc;

#[derive(Debug, Clone, PartialEq)]
pub enum Value {
    Int(i64),
    Num(f64),
    Bool(bool),
    Unit,
    Str(Rc<str>),
    // コード片。マクロ本体の中でだけ現れる
    Syn(Rc<Syn>),
    // 型。実行時には名前だけを持つ
    Ty(Rc<str>),
    Arr(Rc<Vec<Value>>),
    // data の値 (構築子, フィールド)
    Data(Rc<(Name, Vec<Value>)>),
    Fn(Rc<Callable>),
    // 書き換えられる参照。写し取った関数どうしでも同じものを指す
    Ref(Rc<std::cell::RefCell<Value>>),
}

// 関数の値
#[derive(Debug)]
pub enum Callable {
    // ponytail: 作った時の変数を値で写し取る。後から代入しても関数の中には届かない
    Lam {
        params: Vec<Name>,
        body: Block,
        env: HashMap<Name, Value>,
    },
    // トップレベルの関数
    Named(Name),
}

// 関数の値は同じものの時だけ等しい（型検査で比較を禁止していないので、ここで決める）
impl PartialEq for Callable {
    fn eq(&self, o: &Self) -> bool {
        std::ptr::eq(self, o)
    }
}

// 通常の値以外で評価を抜ける理由
enum Flow {
    Return(Value),
    Error(String),
    // handle の腕が resume しなかった。(handle の番号, handle の値)
    Abort(usize, Value),
}

type R<T> = Result<T, Flow>;

// ponytail: 構文木を直接評価する方式。速度が必要ならバイトコードVMに置き換える
struct Interp<'a> {
    fns: HashMap<&'a str, &'a Fn>,
    // 構築子の名前からフィールド名の並び
    ctors: HashMap<&'a str, (&'a Name, Vec<&'a Name>)>,
    out: &'a mut dyn Write,
    // 処理中の handle (番号, 操作の名前から腕の関数)。内側ほど後ろ
    handlers: Vec<(usize, HashMap<Name, Value>)>,
    next_h: usize,
    // 実行時エラーが起きた一番内側の式の位置
    err_at: Option<Span>,
}

// 型検査を通ったプログラムを前提とする
pub fn run(prog: &Program, out: &mut dyn Write) -> Result<Value, Error> {
    run_fn(prog, "main", out)
}

// 引数の無い関数 entry を実行する（main と hibana test のテスト）
pub fn run_fn(
    prog: &Program,
    entry: &str,
    out: &mut dyn Write,
) -> Result<Value, Error> {
    let mut it = Interp {
        fns: prog.fns.iter().map(|f| (f.name.as_str(), f)).collect(),
        ctors: prog
            .datas
            .iter()
            .flat_map(|d| &d.ctors)
            .map(|c| {
                (
                    c.name.as_str(),
                    (&c.name, c.fields.iter().map(|field| &field.0).collect()),
                )
            })
            .collect(),
        out,
        handlers: Vec::new(),
        next_h: 0,
        err_at: None,
    };
    match it.call(entry, vec![]) {
        Ok(v) | Err(Flow::Return(v)) => Ok(v),
        Err(Flow::Error(e)) => {
            let e = Error::from(format!("実行時エラー: {e}"));
            Err(match it.err_at {
                Some(s) => e.at(s),
                None => e,
            }.with_sources(prog.modules.iter().map(|module| &module.source)))
        }
        Err(Flow::Abort(..)) => unreachable!("handle の外には出ない"),
    }
}

// マクロ本体を実行する。put はコンパイル時の出力として標準エラーに書く
pub fn run_macro(b: &Block, vars: Vec<(Name, Value)>, prog: &Program) -> Result<Value, String> {
    let mut err = std::io::stderr();
    let mut it = Interp {
        fns: prog.fns.iter().map(|f| (f.name.as_str(), f)).collect(),
        ctors: prog
            .datas
            .iter()
            .flat_map(|d| &d.ctors)
            .map(|c| {
                (
                    c.name.as_str(),
                    (&c.name, c.fields.iter().map(|field| &field.0).collect()),
                )
            })
            .collect(),
        out: &mut err,
        handlers: Vec::new(),
        next_h: 0,
        err_at: None,
    };
    match it.block(b, &mut vec![vars.into_iter().collect()]) {
        Ok(v) | Err(Flow::Return(v)) => Ok(v),
        Err(Flow::Error(e)) => Err(e),
        Err(Flow::Abort(..)) => unreachable!("handle の外には出ない"),
    }
}

fn show(v: &Value) -> String {
    match v {
        Value::Arr(xs) => format!("[{}]", xs.iter().map(show).collect::<Vec<_>>().join(", ")),
        Value::Int(n) => n.to_string(),
        Value::Num(n) => n.to_string(),
        Value::Bool(b) => b.to_string(),
        Value::Str(s) => format!("{s:?}"),
        Value::Ty(t) => t.to_string(),
        Value::Unit => "()".into(),
        Value::Syn(s) => format!("{:?}", s.node.strip()),
        Value::Fn(_) => "<fn>".into(),
        Value::Ref(_) => "<ref>".into(),
        Value::Data(d) if d.1.is_empty() => d.0.to_string(),
        Value::Data(d) => format!(
            "{}({})",
            d.0,
            d.1.iter().map(show).collect::<Vec<_>>().join(", ")
        ),
    }
}

fn syn(v: Value) -> Rc<Syn> {
    match v {
        Value::Syn(s) => s,
        _ => unreachable!("型検査済み"),
    }
}

fn str_val(v: Value) -> Rc<str> {
    match v {
        Value::Str(s) => s,
        _ => unreachable!("型検査済み"),
    }
}

fn error<T>(msg: String) -> R<T> {
    Err(Flow::Error(msg))
}

fn int(v: Value) -> i64 {
    match v {
        Value::Int(n) => n,
        _ => unreachable!("型検査済み"),
    }
}

fn number(v: &Value) -> f64 {
    match v { Value::Int(n) => *n as f64, Value::Num(n) => *n, _ => unreachable!("型検査済み") }
}

fn value_eq(a: &Value, b: &Value) -> bool {
    match (a, b) {
        (Value::Int(i), Value::Num(f)) | (Value::Num(f), Value::Int(i)) => (*i as f64) == *f,
        (Value::Arr(a), Value::Arr(b)) => a.len() == b.len() && a.iter().zip(b.iter()).all(|(a,b)| value_eq(a,b)),
        (Value::Data(a), Value::Data(b)) => a.0 == b.0 && a.1.len() == b.1.len() && a.1.iter().zip(&b.1).all(|(a,b)| value_eq(a,b)),
        _ => a == b,
    }
}

fn boolean(v: Value) -> bool {
    match v {
        Value::Bool(b) => b,
        _ => unreachable!("型検査済み"),
    }
}

fn arith(op: &str, a: i64, b: i64) -> Option<i64> {
    match op {
        "+" => a.checked_add(b),
        "-" => a.checked_sub(b),
        "*" => a.checked_mul(b),
        "/" => a.checked_div(b),
        // 指数が 52 を超えると、-1・0・1 以外は範囲外になる。-1・0・1 は偶奇だけで決まる
        "**" if b > 52 && !(-1..=1).contains(&a) => None,
        "**" => a.checked_pow(if b > 52 { 52 + b % 2 } else { b } as u32),
        _ => a.checked_rem(b),
    }.filter(|n| (MIN_SAFE_INT..=MAX_SAFE_INT).contains(n))
}

// 整数の指数は各出力先で乗算の順序もそろえる。
pub(crate) fn num_pow(a: f64, b: f64) -> f64 {
    if b.fract() != 0.0 { return a.powf(b); }
    let mut n = b.abs();
    let mut factor = if b < 0.0 { 1.0 / a } else { a };
    let mut result = 1.0;
    while n != 0.0 {
        if n % 2.0 != 0.0 { result *= factor; }
        n = (n / 2.0).trunc();
        if n != 0.0 { factor *= factor; }
    }
    result
}

impl Interp<'_> {
    // マクロ本体用の組み込み関数。該当しなければ None
    fn syn_fn(&mut self, name: &str, vs: &mut Vec<Value>) -> R<Option<Value>> {
        if !matches!(
            name,
            "len"
                | "at"
                | "is_null"
                | "int_of"
                | "str_of"
                | "error"
                | "Vec"
                | "to_str"
                | "split"
                | "starts_with"
                | "slice"
                | "chars"
                | "code"
                | "char_from_codepoint"
                | "panic"
                | "now_ms"
                | "ident"
        ) || self.fns.contains_key(name)
        {
            return Ok(None);
        }
        if name == "now_ms" {
            let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default();
            return Ok(Some(Value::Int(t.as_millis() as i64)));
        }
        let a = vs.remove(0);
        match (name, &a) {
            ("error" | "panic", _) => return error(str_val(a).to_string()),
            ("Vec", _) => return Ok(Some(Value::Ty("Vec".into()))),
            ("len", Value::Arr(xs)) => return Ok(Some(Value::Int(xs.len() as i64))),
            ("len", Value::Str(s)) => return Ok(Some(Value::Int(s.chars().count() as i64))),
            ("to_str", Value::Str(_)) => return Ok(Some(a)),
            ("to_str", v) => return Ok(Some(Value::Str(self.show(v).into()))),
            ("split", Value::Str(s)) => {
                let sep = str_val(vs.remove(0));
                return Ok(Some(Value::Arr(Rc::new(
                    s.split(&*sep).map(|p| Value::Str(p.into())).collect(),
                ))));
            }
            ("starts_with", Value::Str(s)) => {
                return Ok(Some(Value::Bool(s.starts_with(&*str_val(vs.remove(0))))));
            }
            ("slice", Value::Str(s)) => {
                let (i, j) = (int(vs.remove(0)), int(vs.remove(0)));
                let cs: Vec<char> = s.chars().collect();
                if !(0 <= i && i <= j && j as usize <= cs.len()) {
                    return error(format!("slice の範囲 {i}..{j} が文字列の外"));
                }
                return Ok(Some(Value::Str(
                    cs[i as usize..j as usize].iter().collect::<String>().into(),
                )));
            }
            ("chars", Value::Str(s)) => {
                return Ok(Some(Value::Arr(Rc::new(
                    s.chars()
                        .map(|c| Value::Str(c.to_string().into()))
                        .collect(),
                ))));
            }
            ("char_from_codepoint", Value::Int(n)) => {
                let s = u32::try_from(*n).ok().and_then(char::from_u32)
                    .map(|c| c.to_string()).unwrap_or_default();
                return Ok(Some(Value::Str(s.into())));
            }
            ("code", Value::Str(s)) => {
                return Ok(Some(Value::Int(s.chars().next().map_or(-1, |c| c as i64))));
            }
            ("ident", Value::Str(s)) => {
                let tok = Token {
                    tok: Tok::Ident(s.to_string().into()),
                    span: Span::default(),
                    site: None,
                    gap_before: true,
                    nl_before: false,
                };
                let node = Node::At(0..1, Box::new(Node::Ident(s.to_string(), Span::default())));
                return Ok(Some(Value::Syn(Rc::new(Syn {
                    node,
                    toks: Rc::new(vec![tok]),
                }))));
            }
            _ => {}
        }
        let s = syn(a);
        let n = s.node.strip();
        Ok(Some(match (name, n) {
            ("len", Node::List(v)) => Value::Int(v.len() as i64),
            ("at", Node::List(v)) => {
                let i = int(vs.remove(0));
                match usize::try_from(i).ok().and_then(|i| v.get(i)) {
                    Some(x) => Value::Syn(Rc::new(s.child(x.clone()))),
                    None => return error(format!("添字 {i} が範囲外")),
                }
            }
            ("is_null", n) => Value::Bool(matches!(n, Node::Null)),
            ("int_of", Node::Int(i)) => Value::Int(*i),
            ("str_of", Node::Str(x) | Node::Ident(x, _) | Node::Text(x, _) | Node::Token(x, _)) => {
                Value::Str(x.as_str().into())
            }
            ("str_of", Node::Record { .. } | Node::Type(_)) => {
                let Node::At(range, _) = &s.node else { return error("構文の元のトークン列が無い".into()); };
                let mut text = String::new();
                for t in &s.toks[range.clone()] {
                    if t.gap_before && !text.is_empty() { text.push(' '); }
                    use crate::lexer::Tok;
                    text.push_str(&match &t.tok {
                        Tok::Ident(n) => n.to_string(), Tok::Punct(n) => n.to_string(),
                        Tok::Str(n) => format!("{n:?}"), Tok::Int(n) => n.to_string(), Tok::Float(n) => n.to_string(),
                        Tok::Raw(c) => c.to_string(), Tok::Template(n, _) => format!("`{n}`"), Tok::Eof => String::new(),
                    });
                }
                Value::Str(text.into())
            }
            _ => return error(format!("{name} を {n:?} に使えない")),
        }))
    }

    // 値を表示用の文字列にする。構造体はフィールド名を付けて表す
    fn show(&self, v: &Value) -> String {
        match v {
            Value::Arr(xs) => format!(
                "[{}]",
                xs.iter()
                    .map(|x| self.show(x))
                    .collect::<Vec<_>>()
                    .join(", ")
            ),
            Value::Data(d) if d.0.structure_owner().is_some() => {
                let fs = &self.ctors[d.0.as_str()].1;
                let name = d.0.structure_owner().unwrap();
                // struct Name(型, ...) は Name(1, 2)
                if d.0.structure_style() == Some(crate::frontend::name::StructureStyle::Tuple) {
                    let body: Vec<String> = d.1.iter().map(|x| self.show(x)).collect();
                    return format!("{name}({})", body.join(", "));
                }
                let body: Vec<String> = fs
                    .iter()
                    .zip(&d.1)
                    .map(|(f, x)| format!("{f}: {}", self.show(x)))
                    .collect();
                format!("{name} {{ {} }}", body.join(", "))
            }
            Value::Data(d) if !d.1.is_empty() => {
                format!(
                    "{}({})",
                    d.0,
                    d.1.iter()
                        .map(|x| self.show(x))
                        .collect::<Vec<_>>()
                        .join(", ")
                )
            }
            v => show(v),
        }
    }

    // 関数の値を呼ぶ
    fn apply(&mut self, f: &Value, args: Vec<Value>) -> R<Value> {
        let Value::Fn(c) = f else {
            unreachable!("型検査済み")
        };
        match &**c {
            Callable::Named(n) => self.call(n, args),
            Callable::Lam { params, body, env } => {
                let mut scope = env.clone();
                scope.extend(params.iter().cloned().zip(args));
                match self.block(body, &mut vec![scope]) {
                    Err(Flow::Return(v)) => Ok(v),
                    r => r,
                }
            }
        }
    }

    fn call(&mut self, name: &str, args: Vec<Value>) -> R<Value> {
        let f = self.fns[name];
        if f.op.is_some() {
            let k = args.len() - (f.params.len() - f.implicit);
            return self.perform(&f.name, args[k..].to_vec());
        }
        if f.js.is_some() {
            return error(format!(
                "extern の関数 {name} は JavaScript 出力（hibana::to_js）でだけ使える"
            ));
        }
        // 型検査で推論したジェネリック引数は実行時には消えている
        // ponytail: 型引数を値として使うと "?" になる。必要なら型検査の結果を構文木に書き戻す
        let args = if args.len() + f.implicit == f.params.len() {
            let mut full = vec![Value::Ty("?".into()); f.implicit];
            full.extend(args);
            full
        } else {
            args
        };
        let mut env = vec![f.params.iter().map(|(n, _)| n.clone()).zip(args).collect()];
        match self.block(&f.body, &mut env) {
            Err(Flow::Return(v)) => Ok(v),
            r => r,
        }
    }

    // 操作を、それを処理する一番内側の handle の腕で実行する。腕の中の操作は、その handle より外で処理する
    fn perform(&mut self, op: &Name, args: Vec<Value>) -> R<Value> {
        let Some(i) = self.handlers.iter().rposition(|h| h.1.contains_key(op)) else {
            return error(format!("操作 {op} を処理する handle が無い"));
        };
        let (id, f) = (self.handlers[i].0, self.handlers[i].1[op].clone());
        let saved = self.handlers.split_off(i);
        let r = self.apply(&f, args);
        self.handlers.extend(saved);
        match r? {
            Value::Data(d) if d.0 == "$resume" => Ok(d.1[0].clone()),
            v => Err(Flow::Abort(id, v)),
        }
    }

    fn block(&mut self, b: &Block, env: &mut Vec<HashMap<Name, Value>>) -> R<Value> {
        env.push(HashMap::new());
        let r = self.block_inner(b, env);
        env.pop();
        r
    }

    fn block_inner(&mut self, b: &Block, env: &mut Vec<HashMap<Name, Value>>) -> R<Value> {
        for s in &b.stmts {
            match s {
                Stmt::Let { name, init, .. } => {
                    let v = self.expr(init, env)?;
                    env.last_mut().unwrap().insert(name.clone(), v);
                }
                Stmt::Expr(e) => {
                    self.expr(e, env)?;
                }
            }
        }
        match &b.tail {
            Some(e) => self.expr(e, env),
            None => Ok(Value::Unit),
        }
    }

    fn expr(&mut self, e: &Expr, env: &mut Vec<HashMap<Name, Value>>) -> R<Value> {
        let mut e = e;
        while let Expr::Id(_, inner) = e { e = inner; }
        Ok(match e {
            Expr::Id(..) => unreachable!(),
            Expr::At(sp, x) => {
                let r = self.expr(x, env);
                if matches!(r, Err(Flow::Error(_))) && self.err_at.is_none() {
                    self.err_at = Some(*sp);
                }
                r?
            }
            Expr::Int(n) => Value::Int(*n),
            Expr::Num(n) => Value::Num(*n),
            Expr::Bool(b) => Value::Bool(*b),
            Expr::Str(s) => Value::Str(s.as_str().into()),
            Expr::Method(..) | Expr::Macro(..) | Expr::Await(_) => unreachable!("型検査で弾く・書き換える"),
            // 細分化型は実行時には名前だけを持つ型
            Expr::Refine(..) => Value::Ty("refine".into()),
            Expr::Array(items) => {
                let mut vs = Vec::new();
                for a in items {
                    vs.push(self.expr(a, env)?);
                }
                Value::Arr(Rc::new(vs))
            }
            Expr::Index(v, i) => {
                let Value::Arr(xs) = self.expr(v, env)? else {
                    unreachable!("型検査済み")
                };
                let i = int(self.expr(i, env)?);
                // 範囲は型検査で証明済み
                xs[i as usize].clone()
            }
            Expr::Field(x, name) => {
                let v = self.expr(x, env)?;
                if let Value::Data(d) = &v {
                    let i = self.ctors[d.0.as_str()].1
                        .iter()
                        .position(|field| *field == name)
                        .expect("型検査済み");
                    return Ok(d.1[i].clone());
                }
                let s = syn(v);
                match s.node.get(name) {
                    Some(n) => Value::Syn(Rc::new(s.child(n.clone()))),
                    None => return error(format!("フィールド {name} が無い")),
                }
            }
            Expr::Quote(q) => {
                let mut flat: Vec<(Name, Value)> = env
                    .iter()
                    .flat_map(|s| s.iter().map(|(k, v)| (k.clone(), v.clone())))
                    .collect();
                let mut out = Vec::new();
                let mut ev = |e: &Expr, vars: &[(Name, Value)]| {
                    env.push(vars.iter().cloned().collect());
                    let r = self.expr(e, env);
                    env.pop();
                    r.map_err(|f| match f {
                        Flow::Error(e) => Error::from(e),
                        Flow::Return(_) => "${ } の中で return した".into(),
                        Flow::Abort(..) => unreachable!("マクロ本体に handle は無い"),
                    })
                };
                meta::splice(q, &mut flat, &mut out, &mut ev).map_err(|e| Flow::Error(e.msg))?;
                let n = out.len();
                Value::Syn(Rc::new(Syn {
                    node: Node::At(0..n, Box::new(Node::Raw)),
                    toks: Rc::new(out),
                }))
            }
            Expr::Var(n) => match env.iter().rev().find_map(|s| s.get(n)) {
                Some(v) => v.clone(),
                None if self
                    .fns
                    .get(n.as_str())
                    .is_some_and(|f| f.alias && f.params.is_empty()) =>
                {
                    self.call(n, vec![])?
                }
                None if self.fns.contains_key(n.as_str()) => {
                    Value::Fn(Rc::new(Callable::Named(n.clone())))
                }
                None if self.ctors.contains_key(n.as_str()) => {
                    Value::Data(Rc::new((self.ctors[n.as_str()].0.clone(), vec![])))
                }
                // 型検査を通っているので、残りは int などの型名
                None => Value::Ty(n.as_str().into()),
            },
            Expr::Unary("-", x) => {
                let value = self.expr(x, env)?;
                if let Value::Num(n) = value { return Ok(Value::Num(-n)); }
                let n = int(value);
                Value::Int(
                    n.checked_neg().filter(|n| (MIN_SAFE_INT..=MAX_SAFE_INT).contains(n))
                        .ok_or(Flow::Error("オーバーフロー".into()))?,
                )
            }
            Expr::Unary(_, x) => Value::Bool(!boolean(self.expr(x, env)?)),
            Expr::Binary("&&", l, r) => {
                Value::Bool(boolean(self.expr(l, env)?) && boolean(self.expr(r, env)?))
            }
            Expr::Binary("||", l, r) => {
                Value::Bool(boolean(self.expr(l, env)?) || boolean(self.expr(r, env)?))
            }
            Expr::Binary(op, l, r) => {
                let (a, b) = (self.expr(l, env)?, self.expr(r, env)?);
                if matches!(a, Value::Num(_)) || matches!(b, Value::Num(_)) {
                    let (x, y) = (number(&a), number(&b));
                    return match *op {
                        "==" => Ok(Value::Bool(x == y)), "!=" => Ok(Value::Bool(x != y)),
                        "<" => Ok(Value::Bool(x < y)), "<=" => Ok(Value::Bool(x <= y)), ">" => Ok(Value::Bool(x > y)), ">=" => Ok(Value::Bool(x >= y)),
                        "/" | "%" if y == 0.0 => error("0 で除算した".into()),
                        op => {
                            let n = match op { "+" => x + y, "-" => x - y, "*" => x * y, "/" => x / y, "%" => x % y, "**" => num_pow(x, y), _ => unreachable!("型検査済み") };
                            if !n.is_finite() { return error("number の演算結果が有限でない".into()); }
                            Ok(Value::Num(n))
                        }
                    };
                }
                match *op {
                    "+" if matches!(a, Value::Str(_)) => {
                        Value::Str(format!("{}{}", str_val(a), str_val(b)).into())
                    }
                    "==" => Value::Bool(value_eq(&a, &b)),
                    "!=" => Value::Bool(!value_eq(&a, &b)),
                    "<" => Value::Bool(int(a) < int(b)),
                    "<=" => Value::Bool(int(a) <= int(b)),
                    ">" => Value::Bool(int(a) > int(b)),
                    ">=" => Value::Bool(int(a) >= int(b)),
                    _ => {
                        let (a, b) = (int(a), int(b));
                        if b == 0 && matches!(*op, "/" | "%") {
                            return Err(Flow::Error("0 で除算した".into()));
                        }
                        if b < 0 && *op == "**" {
                            return Err(Flow::Error("負の指数".into()));
                        }
                        Value::Int(arith(op, a, b).ok_or(Flow::Error("オーバーフロー".into()))?)
                    }
                }
            }
            Expr::Call(name, args) => {
                let mut vs = Vec::new();
                for a in args {
                    vs.push(self.expr(a, env)?);
                }
                if name == "#num" {
                    match vs.remove(0) { Value::Int(n) => Value::Num(n as f64), v @ Value::Num(_) => v, _ => unreachable!("型検査済み") }
                } else if name == "num_floor" || name == "num_sqrt" {
                    let n = number(&vs[0]);
                    if name == "num_floor" {
                        let n = n.floor();
                        if !(MIN_SAFE_INT as f64..=MAX_SAFE_INT as f64).contains(&n) { return error("floor の結果が int の範囲外".into()); }
                        Value::Int(n as i64)
                    } else {
                        if n < 0.0 { return error("sqrt の引数が負".into()); }
                        Value::Num(n.sqrt())
                    }
                } else if let Some(f) = env.iter().rev().find_map(|s| s.get(name)).cloned() {
                    self.apply(&f, vs)?
                } else if name == "all" && !self.fns.contains_key(name.as_str()) {
                    // 並行の処理が無いので順に実行する
                    let Value::Arr(fs) = &vs[0] else {
                        unreachable!("型検査済み")
                    };
                    let mut out = Vec::new();
                    for f in fs.iter() {
                        out.push(self.apply(f, vec![])?);
                    }
                    Value::Arr(Rc::new(out))
                } else if matches!(name.as_str(), "spawn" | "task_then" | "task_done" | "task_value" | "task_wait")
                    && !self.fns.contains_key(name.as_str())
                {
                    // spawn の時点で最後まで実行し、Task<T> は結果の値そのものにする
                    // ponytail: 実行の待ち行列を持たないので、spawn した処理が JavaScript より先に走る。待ち行列を持てば同じ順序にできる
                    match name.as_str() {
                        "spawn" => self.apply(&vs[0], vec![])?,
                        "task_then" => {
                            let t = vs.remove(0);
                            self.apply(&vs[0], vec![t])?
                        }
                        "task_done" => Value::Bool(true),
                        _ => vs.remove(0),
                    }
                } else if name == "new_ref" && !self.fns.contains_key(name.as_str()) {
                    Value::Ref(Rc::new(std::cell::RefCell::new(vs.pop().unwrap())))
                } else if name == "read" && !self.fns.contains_key(name.as_str()) {
                    let Value::Ref(r) = &vs[0] else {
                        unreachable!("型検査済み")
                    };
                    r.borrow().clone()
                } else if name == "write" && !self.fns.contains_key(name.as_str()) {
                    let x = vs.pop().unwrap();
                    let Value::Ref(r) = &vs[0] else {
                        unreachable!("型検査済み")
                    };
                    *r.borrow_mut() = x;
                    Value::Unit
                } else if name == "push" && !self.fns.contains_key(name.as_str()) {
                    let x = vs.pop().unwrap();
                    let Value::Arr(xs) = vs.pop().unwrap() else {
                        unreachable!("型検査済み")
                    };
                    let mut xs = xs.to_vec();
                    xs.push(x);
                    Value::Arr(Rc::new(xs))
                } else if name == "set_at" && !self.fns.contains_key(name.as_str()) {
                    let x = vs.pop().unwrap();
                    let i = int(vs.pop().unwrap());
                    let Value::Arr(xs) = vs.pop().unwrap() else {
                        unreachable!("型検査済み")
                    };
                    let mut xs = xs.to_vec();
                    xs[i as usize] = x;
                    Value::Arr(Rc::new(xs))
                } else if name == "#resume" {
                    // 腕の値として返し、perform が呼んだ所の値にする
                    Value::Data(Rc::new((
                        "$resume".into(),
                        vec![vs.pop().unwrap_or(Value::Unit)],
                    )))
                } else if self.ctors.contains_key(name.as_str()) {
                    Value::Data(Rc::new((self.ctors[name.as_str()].0.clone(), vs)))
                } else if !self.fns.contains_key(name.as_str())
                    && name != "put"
                    && name.starts_with(|c: char| c.is_ascii_uppercase())
                {
                    // 型を作る呼び出し（Option(int) など）。実行時には名前だけを持つ
                    Value::Ty(name.as_str().into())
                } else if name == "input" {
                    self.out.flush().map_err(|e| Flow::Error(e.to_string()))?;
                    let mut line = String::new();
                    std::io::stdin().read_line(&mut line).map_err(|e| Flow::Error(format!("標準入力を読めません: {e}")))?;
                    if line.ends_with('\n') {
                        line.pop();
                        if line.ends_with('\r') { line.pop(); }
                    }
                    Value::Str(line.into())
                } else if let Some(v) = self.syn_fn(name, &mut vs)? {
                    v
                } else if name == "put" {
                    let s = match &vs[0] {
                        Value::Int(n) => n.to_string(),
                        Value::Num(n) => n.to_string(),
                        Value::Bool(b) => b.to_string(),
                        Value::Unit => "()".into(),
                        Value::Str(s) => s.to_string(),
                        Value::Ty(t) => t.to_string(),
                        Value::Arr(_) | Value::Data(_) | Value::Fn(_) | Value::Ref(_) => {
                            self.show(&vs[0])
                        }
                        Value::Syn(s) => format!("{:?}", s.node.strip()),
                    };
                    writeln!(self.out, "{s}").map_err(|e| Flow::Error(e.to_string()))?;
                    Value::Unit
                } else {
                    self.call(name, vs)?
                }
            }
            Expr::Lam(params, _, _, body) => Value::Fn(Rc::new(Callable::Lam {
                params: params.iter().map(|p| p.0.clone()).collect(),
                body: body.clone(),
                env: env
                    .iter()
                    .flat_map(|s| s.iter().map(|(k, v)| (k.clone(), v.clone())))
                    .collect(),
            })),
            Expr::Pi(..) => Value::Ty("fn".into()),
            Expr::Handle(node, body, arms) => {
                self.next_h += 1;
                let id = self.next_h;
                let mut captured: HashMap<Name, Value> = env
                    .iter()
                    .flat_map(|s| s.iter().map(|(k, v)| (k.clone(), v.clone())))
                    .collect();
                // 腕の中の exit は、この with の番号へ抜ける
                captured.insert(exit_name(*node), Value::Int(id as i64));
                let arms = arms
                    .iter()
                    .map(|a| {
                        let body = Block { id: Default::default(),
                            stmts: vec![],
                            tail: Some(Box::new(a.body.clone())),
                        };
                        let f = Callable::Lam {
                            params: a.binds.clone(),
                            body,
                            env: captured.clone(),
                        };
                        (a.ctor.clone(), Value::Fn(Rc::new(f)))
                    })
                    .collect();
                let n = self.handlers.len();
                self.handlers.push((id, arms));
                let r = self.expr(body, env);
                self.handlers.truncate(n);
                match r {
                    Err(Flow::Abort(h, v)) if h == id => v,
                    r => r?,
                }
            }
            Expr::Exit(target, x) => {
                let v = self.expr(x, env)?;
                let name = exit_name(target.expect("型検査が行き先を書き込む"));
                let Some(Value::Int(h)) = env.iter().rev().find_map(|s| s.get(&name)) else {
                    unreachable!("exit は with の腕の中だけ")
                };
                return Err(Flow::Abort(*h as usize, v));
            }
            Expr::Apply(f, args) => {
                let f = self.expr(f, env)?;
                let mut vs = Vec::new();
                for a in args {
                    vs.push(self.expr(a, env)?);
                }
                self.apply(&f, vs)?
            }
            Expr::Match(s, arms) => {
                let Value::Data(d) = self.expr(s, env)? else {
                    unreachable!("型検査済み")
                };
                let arm = arms
                    .iter()
                    .find(|a| a.ctor == d.0 || a.ctor == "_")
                    .expect("網羅性は型検査済み");
                let mut scope = HashMap::new();
                if arm.ctor != "_" {
                    scope.extend(arm.binds.iter().cloned().zip(d.1.iter().cloned()));
                }
                env.push(scope);
                let r = self.expr(&arm.body, env);
                env.pop();
                r?
            }
            // x = push(x, e): 他から指されていなければ（Rc が一つなら）写さずに足す
            Expr::Assign(name, x)
                if x.self_push(name).is_some() && !self.fns.contains_key("push") =>
            {
                let v = self.expr(x.self_push(name).unwrap(), env)?;
                let slot = env.iter_mut().rev().find_map(|s| s.get_mut(name)).unwrap();
                let Value::Arr(xs) = slot else {
                    unreachable!("型検査済み")
                };
                Rc::make_mut(xs).push(v);
                Value::Unit
            }
            Expr::Assign(name, x)
                if x.self_set(name).is_some() && !self.fns.contains_key("set_at") =>
            {
                let (i, e) = x.self_set(name).unwrap();
                let i = int(self.expr(i, env)?);
                let v = self.expr(e, env)?;
                let slot = env.iter_mut().rev().find_map(|s| s.get_mut(name)).unwrap();
                let Value::Arr(xs) = slot else {
                    unreachable!("型検査済み")
                };
                Rc::make_mut(xs)[i as usize] = v;
                Value::Unit
            }
            Expr::Assign(name, x) => {
                let v = self.expr(x, env)?;
                *env.iter_mut().rev().find_map(|s| s.get_mut(name)).unwrap() = v;
                Value::Unit
            }
            Expr::If(c, then, els) => {
                if boolean(self.expr(c, env)?) {
                    self.block(then, env)?
                } else if let Some(x) = els {
                    self.expr(x, env)?
                } else {
                    Value::Unit
                }
            }
            Expr::For(x, it, end, body) => {
                let items: Vec<Value> = match end {
                    Some(end) => (int(self.expr(it, env)?)..int(self.expr(end, env)?))
                        .map(Value::Int)
                        .collect(),
                    None => match self.expr(it, env)? {
                        Value::Arr(xs) => xs.to_vec(),
                        _ => unreachable!("型検査済み"),
                    },
                };
                for v in items {
                    env.push(HashMap::from([(x.clone(), v)]));
                    let r = self.block(body, env);
                    env.pop();
                    r?;
                }
                Value::Unit
            }
            Expr::While(c, body) => {
                while boolean(self.expr(c, env)?) {
                    self.block(body, env)?;
                }
                Value::Unit
            }
            Expr::Block(b) => self.block(b, env)?,
            Expr::Return(x) => {
                let v = match x {
                    Some(x) => self.expr(x, env)?,
                    None => Value::Unit,
                };
                return Err(Flow::Return(v));
            }
        })
    }
}

// with（Handle）の番号を腕に渡す変数の名前
fn exit_name(node: crate::parser::NodeId) -> Name {
    Name::temporary("exit", node.raw() as usize)
}
