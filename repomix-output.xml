        assert!(e.contains("添字の範囲"), "{e}");
        // ループの後は長さが分からない
        let e = out("fn main() { let mut v = [1]\n for i in 0..2 { v = push(v, 1) }\n put(v[1]) }").unwrap_err();
        assert!(e.contains("添字の範囲"), "{e}");
