{
  "name": "hibana",
  "scopeName": "source.hibana",
  "patterns": [
    { "name": "comment.line.double-slash.hibana", "match": "//.*$" },
    { "name": "comment.block.hibana", "begin": "/\\*", "end": "\\*/" },
    {
      "name": "string.quoted.double.hibana",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.hibana", "match": "\\\\." }]
    },
    { "name": "string.quoted.single.hibana", "match": "'([^'\\\\]|\\\\.)'" },
    {
      "name": "keyword.control.hibana",
      "match": "\\b(fn|let|mut|if|else|while|return|syntax|macro|type|match|quote|partial|for|in|use|module|extern|effect|handle)\\b"
    },
    { "name": "constant.language.boolean.hibana", "match": "\\b(true|false)\\b" },
    { "name": "support.type.primitive.hibana", "match": "\\b(int|bool|str|unit|never|float)\\b" },
    { "name": "constant.numeric.hibana", "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+(\\.[0-9]+)?)\\b" },
    { "name": "entity.name.function.hibana", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()" },
    { "name": "entity.name.type.hibana", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    { "name": "variable.other.splice.hibana", "match": "\\$[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "keyword.operator.hibana", "match": "->|=>|==|!=|<=|>=|&&|\\|\\||[-+*/%=<>!|~?]" }
  ]
}
