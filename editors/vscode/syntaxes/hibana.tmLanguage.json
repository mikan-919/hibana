{
  "name": "hibana",
  "scopeName": "source.hibana",
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "name": "comment.line.double-slash.hibana", "match": "//.*$" },
        { "name": "comment.block.hibana", "begin": "/\\*", "end": "\\*/" },
        {
          "name": "string.quoted.single.hibana",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.hibana", "match": "\\\\." }]
        },
        {
          "name": "string.template.hibana",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "name": "constant.character.escape.hibana", "match": "\\\\." },
            {
              "name": "meta.embedded.interpolation.hibana",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.hibana" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.hibana" } },
              "contentName": "source.hibana",
              "patterns": [{ "include": "#braces" }, { "include": "#code" }]
            }
          ]
        },
        {
          "name": "keyword.control.hibana",
          "match": "\\b(fn|let|mut|if|else|while|return|syntax|macro|type|match|quote|partial|for|in|use|module|extern|effect|handle|trait|impl|struct|enum)\\b"
        },
        { "name": "constant.language.boolean.hibana", "match": "\\b(true|false)\\b" },
        { "name": "support.type.primitive.hibana", "match": "\\b(int|bool|str|unit|never|float)\\b" },
        { "name": "constant.numeric.hibana", "match": "\\b(0[xX][0-9a-fA-F]+|[0-9]+(\\.[0-9]+)?)\\b" },
        { "name": "entity.name.function.hibana", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()" },
        { "name": "entity.name.type.hibana", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
        { "name": "variable.other.splice.hibana", "match": "\\$[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "punctuation.separator.path.hibana", "match": "::" },
        { "name": "keyword.operator.hibana", "match": "->|=>|==|!=|<=|>=|&&|\\|\\||[-+*/%=<>!|~?]" }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#braces" }, { "include": "#code" }]
    }
  }
}
